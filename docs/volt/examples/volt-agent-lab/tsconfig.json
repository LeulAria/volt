{
	// The published build: src/extension.ts and src/lab.ts, no test fixture.
	// In your own extension use "@types/vscode" and a copy of apps/volt-extension-api/vscode.proposed.volt.d.ts
	// instead of these paths into the Volt repository.
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": [
			"ES2022"
		],
		"typeRoots": [
			"../../../../node_modules/@types"
		],
		"types": [
			"node"
		],
		"strict": true,
		"outDir": "out",
		"rootDir": "src",
		"removeComments": true,
		"skipLibCheck": true
	},
	"files": [
		"src/extension.ts",
		"src/lab.ts",
		"../../../../src/vscode-dts/vscode.d.ts",
		"../../../../apps/volt-extension-api/vscode.proposed.volt.d.ts"
	]
}
