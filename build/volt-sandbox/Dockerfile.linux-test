# Linux test rig for Volt's bubblewrap sandbox backend (scripts/volt-sandbox-linux-test.sh).
#
# Ubuntu 24.04 (bubblewrap 0.9, util-linux 2.39) with Node 22 copied from the official image,
# socat for the network bridge, python3 and perl for the adversarial probes, git for the `.git`
# allow list (PERS-*) and HostGit (GIT-*) tests, and a non-root user: the backend must work
# unprivileged, as on a developer's machine.

FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		bubblewrap socat util-linux procps psmisc curl ca-certificates python3 iproute2 git \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node

# Ubuntu's image already has uid 1000 (ubuntu); the rig runs as a separate, unprivileged user.
RUN useradd --create-home --uid 1500 --shell /bin/bash volt
USER volt
WORKDIR /home/volt
