# Linux test rig for Volt's bubblewrap sandbox backend (scripts/volt-sandbox-linux-test.sh).
#
# Ubuntu 24.04 (util-linux 2.39) with bubblewrap 0.13.1 built from the pinned release tarball
# and installed as the system /usr/bin/bwrap (Volt uses only that one; Ubuntu's own 0.9.0 has
# CVE-2026-87766 and is refused, see Dockerfile.linux-test-bwrap-0.9), Node 22 copied from the
# official image, socat for the network bridge, python3 and perl (with MIME::Base64, for the proxy
# token) for the adversarial probes, and a non-root user: the backend must work unprivileged, as
# on a developer's machine.

FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04 AS bwrap
ARG BWRAP_VERSION=0.13.1
ARG BWRAP_SHA256=0e85c8702248b8dd64144f594147553650cdd0e4c951690345faace79c217c4d
RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		ca-certificates curl xz-utils gcc libc6-dev libcap-dev meson ninja-build pkg-config \
	&& rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/bwrap.tar.xz "https://github.com/containers/bubblewrap/releases/download/v${BWRAP_VERSION}/bubblewrap-${BWRAP_VERSION}.tar.xz" \
	&& echo "${BWRAP_SHA256}  /tmp/bwrap.tar.xz" | sha256sum -c - \
	&& tar -C /tmp -xf /tmp/bwrap.tar.xz \
	&& cd "/tmp/bubblewrap-${BWRAP_VERSION}" \
	&& meson setup _build --prefix=/usr -Dman=disabled -Dselinux=disabled -Dtests=false -Dbash_completion=disabled -Dzsh_completion=disabled \
	&& ninja -C _build \
	&& DESTDIR=/out ninja -C _build install

FROM ubuntu:24.04

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		libcap2 socat util-linux procps psmisc curl ca-certificates python3 perl iproute2 \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=bwrap /out/usr/bin/bwrap /usr/bin/bwrap
RUN bwrap --version | grep -qx 'bubblewrap 0.13.1'

COPY --from=node /usr/local/bin/node /usr/local/bin/node

# Ubuntu's image already has uid 1000 (ubuntu); the rig runs as a separate, unprivileged user.
RUN useradd --create-home --uid 1500 --shell /bin/bash volt
USER volt
WORKDIR /home/volt
