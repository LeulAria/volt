{
	"name": "playgrounds",
	"displayName": "Volt: Playgrounds",
	"description": "Throwaway pages agents build and check outside the project. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "playgrounds",
			"label": "Playgrounds",
			"description": "Throwaway pages agents build and check outside the project.",
			"category": "tools",
			"icon": "beaker",
			"order": 20
		},
		"voltTools": [
			{
				"name": "playground_create",
				"class": "safe"
			},
			{
				"name": "playground_update",
				"class": "safe"
			},
			{
				"name": "playground_list",
				"class": "safe"
			},
			{
				"name": "playground_delete",
				"class": "safe"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "tools.register",
					"class": "low"
				},
				{
					"id": "net.listen:*",
					"class": "high",
					"reason": "Serves draft pages over loopback."
				}
			]
		}
	}
}
