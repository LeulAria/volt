{
	"name": "provider-openrouter",
	"displayName": "Volt: OpenRouter Provider",
	"description": "Models through OpenRouter in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.openrouter",
			"label": "OpenRouter",
			"description": "Models through OpenRouter.",
			"category": "providers",
			"icon": "hubot",
			"order": 120
		},
		"voltAgents": [
			{
				"id": "openrouter",
				"label": "OpenRouter",
				"models": {
					"source": "api"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "net.connect",
					"class": "low",
					"targets": [
						"openrouter.ai"
					]
				},
				{
					"id": "secrets.use:openrouter",
					"class": "high"
				}
			]
		}
	}
}
