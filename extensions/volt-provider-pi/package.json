{
	"name": "provider-pi",
	"displayName": "Volt: Pi Provider",
	"description": "The Pi coding agent in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.pi",
			"label": "Pi",
			"description": "The Pi coding agent.",
			"category": "providers",
			"icon": "hubot",
			"order": 60
		},
		"voltAgents": [
			{
				"id": "pi",
				"label": "Pi",
				"order": 60,
				"binary": "pi",
				"versionArgs": [
					"--version"
				],
				"args": [],
				"earlyAccess": true,
				"acpAdapter": {
					"command": "pi-acp",
					"package": "pi-acp@0.0.34"
				},
				"authProbe": "pi",
				"apiHosts": [
					"pi.dev",
					"*.pi.dev",
					"api.anthropic.com",
					"api.openai.com",
					"chatgpt.com",
					"*.chatgpt.com",
					"auth.openai.com",
					"openrouter.ai",
					"*.openrouter.ai",
					"generativelanguage.googleapis.com",
					"api.x.ai",
					"api.deepseek.com",
					"api.moonshot.ai",
					"api.z.ai",
					"api.groq.com",
					"api.mistral.ai",
					"api.cerebras.ai"
				],
				"state": {
					"writable": [
						".pi/agent/sessions",
						".pi/agent/logs"
					],
					"writableFiles": [
						".pi/agent/auth.json"
					],
					"readable": [
						".pi"
					],
					"credentials": [
						".pi/agent/auth.json"
					],
					"envKeys": [
						"ANTHROPIC_API_KEY",
						"OPENAI_API_KEY",
						"OPENROUTER_API_KEY",
						"GEMINI_API_KEY",
						"XAI_API_KEY",
						"GROQ_API_KEY",
						"MISTRAL_API_KEY",
						"CEREBRAS_API_KEY"
					]
				},
				"models": {
					"source": "acp"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "secrets.use:pi",
					"class": "high",
					"reason": "The provider's sign-in or API key."
				}
			]
		}
	}
}
