{
	"name": "provider-pi",
	"displayName": "Volt: Pi Provider",
	"description": "The Pi coding agent in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.pi",
			"label": "Pi",
			"description": "The Pi coding agent.",
			"category": "providers",
			"icon": "hubot",
			"order": 60
		},
		"voltAgents": [
			{
				"id": "pi",
				"label": "Pi",
				"binary": "pi",
				"models": {
					"source": "acp"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "secrets.use:pi",
					"class": "high",
					"reason": "The provider's sign-in or API key."
				}
			]
		}
	}
}
