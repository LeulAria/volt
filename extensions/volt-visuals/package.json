{
	"name": "visuals",
	"displayName": "Volt: Charts, HTML and Canvas",
	"description": "Charts, HTML pages, mockups and the canvas, drawn in the chat. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "visuals",
			"label": "Charts, HTML and canvas",
			"description": "Charts, HTML pages, mockups and the canvas, drawn in the chat.",
			"category": "tools",
			"icon": "graph",
			"order": 30,
			"settings": [
				"volt.canvas."
			]
		},
		"voltTools": [
			{
				"name": "render_chart",
				"class": "safe"
			},
			{
				"name": "html_render",
				"class": "reads"
			},
			{
				"name": "html_preview",
				"class": "reads"
			},
			{
				"name": "mockups_render",
				"class": "safe"
			},
			{
				"name": "screens_capture",
				"class": "reads"
			},
			{
				"name": "canvas_render",
				"class": "reads"
			},
			{
				"name": "canvas_update",
				"class": "reads"
			},
			{
				"name": "canvas_read",
				"class": "safe"
			}
		],
		"voltSurfaces": [
			{
				"id": "canvas",
				"label": "Canvas"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "tools.register",
					"class": "low"
				},
				{
					"id": "files.read:workspace",
					"class": "low",
					"reason": "Local images in pages and canvas frames."
				},
				{
					"id": "browser.drive",
					"class": "high",
					"reason": "screens_capture opens web pages."
				},
				{
					"id": "devices.drive",
					"class": "high",
					"reason": "screens_capture drives a simulator."
				}
			]
		}
	}
}
