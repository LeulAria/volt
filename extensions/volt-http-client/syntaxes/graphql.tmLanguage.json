{
	"name": "GraphQL",
	"scopeName": "source.graphql",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#description"
		},
		{
			"include": "#string"
		},
		{
			"include": "#directive"
		},
		{
			"include": "#variable"
		},
		{
			"include": "#spread"
		},
		{
			"include": "#definition"
		},
		{
			"include": "#keyword"
		},
		{
			"include": "#constant"
		},
		{
			"include": "#number"
		},
		{
			"include": "#argument"
		},
		{
			"include": "#alias"
		},
		{
			"include": "#type"
		},
		{
			"include": "#field"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comment": {
			"match": "#.*$",
			"name": "comment.line.number-sign.graphql"
		},
		"description": {
			"begin": "\"\"\"",
			"end": "\"\"\"",
			"name": "string.quoted.docstring.graphql"
		},
		"string": {
			"begin": "\"",
			"end": "\"|$",
			"name": "string.quoted.double.graphql",
			"patterns": [
				{
					"match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})",
					"name": "constant.character.escape.graphql"
				}
			]
		},
		"directive": {
			"match": "@[_A-Za-z]\\w*",
			"name": "entity.name.function.directive.graphql"
		},
		"variable": {
			"match": "\\$[_A-Za-z]\\w*",
			"name": "variable.parameter.graphql"
		},
		"spread": {
			"match": "(\\.\\.\\.)\\s*(?:(on)\\s+([_A-Za-z]\\w*)|(?!on\\b)([_A-Za-z]\\w*))?",
			"captures": {
				"1": {
					"name": "keyword.operator.spread.graphql"
				},
				"2": {
					"name": "keyword.control.graphql"
				},
				"3": {
					"name": "support.type.graphql"
				},
				"4": {
					"name": "entity.name.function.fragment.graphql"
				}
			}
		},
		"definition": {
			"match": "\\b(query|mutation|subscription|fragment)\\b(?:\\s+([_A-Za-z]\\w*))?(?:\\s+(on)\\s+([_A-Za-z]\\w*))?",
			"captures": {
				"1": {
					"name": "keyword.control.graphql"
				},
				"2": {
					"name": "entity.name.function.graphql"
				},
				"3": {
					"name": "keyword.control.graphql"
				},
				"4": {
					"name": "support.type.graphql"
				}
			}
		},
		"keyword": {
			"match": "\\b(schema|scalar|type|interface|union|enum|input|extend|implements|directive|repeatable|on)\\b",
			"name": "keyword.control.graphql"
		},
		"constant": {
			"match": "\\b(true|false|null)\\b",
			"name": "constant.language.graphql"
		},
		"number": {
			"match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
			"name": "constant.numeric.graphql"
		},
		"argument": {
			"match": "([_A-Za-z]\\w*)\\s*(:)(?=\\s*(?:[$\"\\[{\\-\\d]|true\\b|false\\b|null\\b))",
			"captures": {
				"1": {
					"name": "variable.parameter.graphql"
				},
				"2": {
					"name": "punctuation.separator.graphql"
				}
			}
		},
		"alias": {
			"match": "([_A-Za-z]\\w*)\\s*(:)\\s*(?=[_a-z])",
			"captures": {
				"1": {
					"name": "entity.name.tag.alias.graphql"
				},
				"2": {
					"name": "punctuation.separator.graphql"
				}
			}
		},
		"type": {
			"match": "\\b(?:Int|Float|String|Boolean|ID)\\b|\\b[A-Z]\\w*\\b",
			"name": "support.type.graphql"
		},
		"field": {
			"match": "[_A-Za-z]\\w*",
			"name": "variable.other.property.graphql"
		},
		"punctuation": {
			"match": "[!:=|&]",
			"name": "keyword.operator.graphql"
		}
	}
}
