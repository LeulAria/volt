{
	"name": "http-client",
	"displayName": "Volt: Volt Client",
	"description": "Volt Client: send and save HTTP, GraphQL, WebSocket, SSE, Socket.IO, MQTT, gRPC, MCP, SOAP and AI requests in .http files and Postman collections, from the right panel's + menu. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "httpClient",
			"label": "Volt Client",
			"description": "Send and save API requests (HTTP, GraphQL, WebSocket, gRPC and more) in .http files and Postman collections, from the right panel's + menu.",
			"category": "tools",
			"icon": "send",
			"order": 25,
			"commands": [
				"volt.http.openInTools",
				"volt.http.newRequest",
				"volt.http.selectEnvironment",
				"volt.http.refresh"
			],
			"toolCapabilities": [
				"ide.http"
			]
		},
		"voltSurfaces": [
			{
				"id": "http",
				"label": "Volt Client"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "net.connect",
					"class": "low",
					"reason": "The requests the user sends."
				},
				{
					"id": "net.loopback.connect:*",
					"class": "high",
					"reason": "Requests to the user's local servers."
				},
				{
					"id": "files.read:workspace",
					"class": "low",
					"reason": "The project's .http files and environments."
				},
				{
					"id": "files.write",
					"class": "medium",
					"reason": "Saves a request the user keeps as an .http file."
				}
			]
		},
		"languages": [
			{
				"id": "graphql",
				"aliases": [
					"GraphQL",
					"graphql",
					"gql"
				],
				"extensions": [
					".graphql",
					".gql",
					".graphqls"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "graphql",
				"scopeName": "source.graphql",
				"path": "./syntaxes/graphql.tmLanguage.json"
			}
		]
	}
}
