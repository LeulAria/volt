{
	"name": "provider-kimi",
	"displayName": "Volt: Kimi Provider",
	"description": "Kimi models in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.kimi",
			"label": "Kimi",
			"description": "Kimi models.",
			"category": "providers",
			"icon": "hubot",
			"order": 80
		},
		"voltAgents": [
			{
				"id": "kimi",
				"label": "Kimi Code",
				"order": 80,
				"binary": "kimi",
				"versionArgs": [
					"--version"
				],
				"args": [
					"acp"
				],
				"authProbe": "kimi",
				"apiHosts": [
					"*.moonshot.ai",
					"*.moonshot.cn",
					"kimi.com",
					"*.kimi.com"
				],
				"state": {
					"writable": [
						".kimi/sessions",
						".kimi/logs",
						".kimi-code/sessions",
						".kimi-code/logs"
					],
					"readable": [
						".kimi",
						".kimi-code"
					],
					"envKeys": [
						"MOONSHOT_API_KEY",
						"KIMI_API_KEY"
					]
				},
				"models": {
					"source": "acp"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "secrets.use:kimi",
					"class": "high",
					"reason": "The provider's sign-in or API key."
				}
			]
		}
	}
}
