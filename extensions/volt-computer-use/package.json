{
	"name": "computer-use",
	"displayName": "Volt: Computer Use",
	"description": "Agents read and drive native apps on this Mac through accessibility. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "computerUse",
			"label": "Computer use",
			"description": "Agents read and drive native apps on this Mac through accessibility.",
			"category": "tools",
			"icon": "device-desktop",
			"order": 60,
			"settings": [
				"volt.computerUse."
			]
		},
		"voltTools": [
			{
				"name": "desktop_apps",
				"class": "escapes"
			},
			{
				"name": "desktop_snapshot",
				"class": "escapes"
			},
			{
				"name": "desktop_act",
				"class": "escapes"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "tools.register",
					"class": "low"
				},
				{
					"id": "desktop.control",
					"class": "critical"
				},
				{
					"id": "screen.capture",
					"class": "critical"
				},
				{
					"id": "spawn.unsandboxed",
					"class": "critical",
					"reason": "The desktop tools act on the user's apps."
				}
			]
		}
	}
}
