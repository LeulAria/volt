{
	"name": "commit-review",
	"displayName": "Volt: Commit Review",
	"description": "Agents propose commits for you to review, and name a worktree's branch. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "commitReview",
			"label": "Commit review",
			"description": "Agents propose commits for the user to review, and name a worktree's branch.",
			"category": "workspace",
			"icon": "git-compare",
			"order": 70,
			"entry": "voltCommitReview"
		},
		"voltTools": [
			{
				"name": "propose_commits",
				"class": "safe"
			},
			{
				"name": "await_commits",
				"class": "safe"
			},
			{
				"name": "rename_branch",
				"class": "escapes"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "tools.register",
					"class": "low"
				},
				{
					"id": "git.read",
					"class": "medium"
				},
				{
					"id": "git.write",
					"class": "high"
				},
				{
					"id": "spawn.unsandboxed",
					"class": "critical",
					"reason": "rename_branch runs git (and its hooks) on the host."
				}
			]
		}
	}
}
