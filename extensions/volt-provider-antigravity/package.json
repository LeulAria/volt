{
	"name": "provider-antigravity",
	"displayName": "Volt: Antigravity Provider",
	"description": "Antigravity and Gemini models in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.antigravity",
			"label": "Antigravity",
			"description": "Antigravity and Gemini models.",
			"category": "providers",
			"icon": "hubot",
			"order": 70
		},
		"voltAgents": [
			{
				"id": "antigravity",
				"label": "Antigravity",
				"binary": "agy",
				"args": [
					"acp"
				],
				"models": {
					"source": "acp"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "secrets.use:antigravity",
					"class": "high",
					"reason": "The provider's sign-in or API key."
				}
			]
		}
	}
}
