{
	"name": "provider-codex",
	"displayName": "Volt: Codex Provider",
	"description": "Codex (OpenAI's CLI) and OpenAI API models in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.codex",
			"label": "Codex",
			"description": "Codex (OpenAI's CLI) and OpenAI API models.",
			"category": "providers",
			"icon": "hubot",
			"order": 20
		},
		"voltAgents": [
			{
				"id": "codex",
				"label": "Codex",
				"binary": "codex",
				"models": {
					"source": "acp"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "secrets.use:codex",
					"class": "high",
					"reason": "The provider's sign-in or API key."
				}
			]
		}
	}
}
