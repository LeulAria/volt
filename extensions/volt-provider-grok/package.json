{
	"name": "provider-grok",
	"displayName": "Volt: Grok Provider",
	"description": "Grok (xAI) models in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.grok",
			"label": "Grok",
			"description": "Grok (xAI) models.",
			"category": "providers",
			"icon": "hubot",
			"order": 40
		},
		"voltAgents": [
			{
				"id": "grok",
				"label": "Grok",
				"order": 40,
				"binary": "grok",
				"versionArgs": [
					"--version"
				],
				"args": [
					"agent",
					"stdio"
				],
				"earlyAccess": true,
				"authProbe": "grok",
				"apiHosts": [
					"x.ai",
					"*.x.ai",
					"grok.com",
					"*.grok.com"
				],
				"state": {
					"writable": [
						".grok/sessions",
						".grok/logs",
						".grok/memory-v2",
						".grok/memtrace",
						".grok/grove",
						".grok/downloads",
						".local/state/grok"
					],
					"writableFiles": [
						".grok/auth.json",
						".grok/auth.json.lock",
						".grok/active_sessions.json",
						".grok/active_sessions.lock",
						".grok/worktrees.db",
						".grok/worktrees.db-wal",
						".grok/worktrees.db-shm",
						".grok/models_cache.json",
						".grok/settings_cache.json",
						".grok/tip_cursor.json",
						".grok/agent_id",
						".grok/.config-init.lock",
						".grok/managed_config.lock",
						".grok/.metadata_version"
					],
					"readable": [
						".grok"
					],
					"credentials": [
						".grok/auth.json"
					],
					"envKeys": [
						"XAI_API_KEY",
						"GROK_API_KEY"
					],
					"quietPaths": {
						"processes": [
							"grok"
						],
						"paths": [
							".grok/bundled",
							".grok/installed-plugins",
							".grok/version.json",
							".grok/experiments_remote_opt_out"
						],
						"readPaths": [
							".agents/skills",
							".claude/skills",
							".claude/plugins",
							".claude.json",
							".claude/settings.json",
							".claude/settings.local.json",
							".cursor/skills",
							".cursor/mcp.json"
						]
					}
				},
				"models": {
					"source": "acp"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "secrets.use:grok",
					"class": "high",
					"reason": "The provider's sign-in or API key."
				}
			]
		}
	}
}
