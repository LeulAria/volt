{
	"name": "provider-grok",
	"displayName": "Volt: Grok Provider",
	"description": "Grok (xAI) models in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.grok",
			"label": "Grok",
			"description": "Grok (xAI) models.",
			"category": "providers",
			"icon": "hubot",
			"order": 40
		},
		"voltAgents": [
			{
				"id": "grok",
				"label": "Grok",
				"binary": "grok",
				"args": [
					"agent",
					"stdio"
				],
				"models": {
					"source": "acp"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "secrets.use:grok",
					"class": "high",
					"reason": "The provider's sign-in or API key."
				}
			]
		}
	}
}
