{
	"name": "provider-local",
	"displayName": "Volt: Local Models Provider",
	"description": "Ollama, LM Studio and any OpenAI-compatible server on your machine, in the model picker and Providers & Models. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"provider",
		"model"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "provider.local",
			"label": "Local models",
			"description": "Ollama, LM Studio and any OpenAI-compatible server on your machine.",
			"category": "providers",
			"icon": "hubot",
			"order": 110
		},
		"voltAgents": [
			{
				"id": "local",
				"label": "Local models",
				"models": {
					"source": "api"
				}
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "net.loopback.connect:11434",
					"class": "high",
					"reason": "Ollama."
				},
				{
					"id": "net.loopback.connect:1234",
					"class": "high",
					"reason": "LM Studio."
				}
			]
		}
	}
}
