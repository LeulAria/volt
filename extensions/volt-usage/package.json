{
	"name": "usage",
	"displayName": "Volt: Usage",
	"description": "Usage limits and runway for every account: the Usage page and button, the side toolbar section and the Session Usage card. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "usage",
			"label": "Usage",
			"description": "Usage limits and runway for every account, the Usage page and button, and its side toolbar section.",
			"category": "productivity",
			"icon": "pulse",
			"order": 20,
			"commands": [
				"workbench.action.voltAgent.usage"
			]
		},
		"voltSlotItems": [
			{
				"id": "volt.usage",
				"label": "Usage"
			}
		],
		"voltSettingsPages": [
			{
				"id": "usage",
				"label": "Usage"
			}
		],
		"voltDock": [
			{
				"id": "usage",
				"label": "Usage"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "usage.report",
					"class": "low"
				},
				{
					"id": "net.connect",
					"class": "low",
					"reason": "Each provider's usage endpoint."
				},
				{
					"id": "secrets.use:*",
					"class": "high",
					"reason": "Each account's sign-in, to read its limits."
				}
			]
		}
	}
}
