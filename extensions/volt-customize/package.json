{
	"name": "customize",
	"displayName": "Volt: Customize Volt",
	"description": "Looks, layouts and slots, the Customize Volt page, and the Playground where agents change Volt. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "customize",
			"label": "Customize Volt",
			"description": "Looks, layouts and slots, the Customize Volt page, and the Playground where agents change Volt.",
			"category": "customize",
			"icon": "paintcan",
			"order": 10,
			"commands": [
				"volt.customize.open",
				"volt.customize.openPlayground",
				"volt.customize.selectLayout",
				"volt.customize.selectLook"
			],
			"settings": [
				"volt.customize.",
				"volt.look."
			]
		},
		"voltSettingsPages": [
			{
				"id": "customizeVolt",
				"label": "Customize Volt"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "files.write",
					"class": "medium",
					"targets": [
						"~/.volt/customize/*"
					],
					"reason": "Looks, layouts and Playground drafts."
				}
			]
		}
	}
}
