{
	"name": "memory",
	"displayName": "Volt: Memory",
	"description": "Notes agents keep between chats, and skills they write for themselves. Disable this extension to turn the feature off.",
	"version": "0.0.1",
	"publisher": "volt",
	"license": "MIT",
	"engines": {
		"vscode": "*",
		"volt": "^1.0.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"volt",
		"feature"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"voltModule": {
			"feature": "memory",
			"label": "Memory",
			"description": "Notes agents keep between chats, and skills they write for themselves.",
			"category": "productivity",
			"icon": "database",
			"order": 30
		},
		"voltTools": [
			{
				"name": "memory_list",
				"class": "safe"
			},
			{
				"name": "memory_read",
				"class": "safe"
			},
			{
				"name": "memory_write",
				"class": "persists"
			},
			{
				"name": "skill_write",
				"class": "persists"
			},
			{
				"name": "memory_delete",
				"class": "persists"
			}
		],
		"voltCapabilities": {
			"required": [
				{
					"id": "tools.register",
					"class": "low"
				},
				{
					"id": "agents.context",
					"class": "high",
					"reason": "Notes and skills later chats read."
				}
			]
		}
	}
}
