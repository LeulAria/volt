# Public URL of this deployment (the Better Auth base URL; SSO callbacks and invite links use it).
BETTER_AUTH_URL=http://localhost:4318
# Session/cookie signing secret: 32+ random characters. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Master key for provider credentials and the signing key: 32 random bytes, base64. `openssl rand -base64 32`
# Rotating it means re-encrypting stored credentials (see README).
VOLT_GOVERN_MASTER_KEY=
# HMAC secret for SCIM bearer credentials: 32+ random characters.
VOLT_GOVERN_SCIM_SECRET=
# Postgres in production. Leave empty to use a local SQLite file (./volt-govern.db).
DATABASE_URL=
PORT=4318
# Origins allowed to call the API with cookies (the web console in dev runs on 5179).
TRUSTED_ORIGINS=http://localhost:5179
