{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": [
			"vite/client"
		],
		"paths": {
			"@volt/client-core": [
				"../client-core/src/index.ts"
			]
		}
	},
	"include": [
		"src/web",
		"src/shared",
		"vite.config.ts"
	]
}
