{
	"name": "volt-mobile",
	"version": "0.1.0",
	"private": true,
	"description": "Volt for iPhone, iPad and Android: a native shell around the Volt workbench your computer serves, paired with it over your network.",
	"license": "MIT",
	"author": "Volt ADK",
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"ios": "node scripts/run.mjs ios",
		"android": "node scripts/run.mjs android",
		"prebuild": "expo prebuild",
		"build:ios": "node scripts/fastBuild.mjs ios",
		"build:android": "node scripts/fastBuild.mjs android",
		"release:ios": "node scripts/releaseBuild.mjs ios",
		"release:android": "node scripts/releaseBuild.mjs android",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"postinstall": "npm --prefix ../mobile-widgets install --omit=peer --no-package-lock --no-audit --no-fund --loglevel=error"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "2.2.0",
		"@volt/client-core": "file:../client-core",
		"expo": "~57.0.31",
		"expo-build-properties": "~57.0.22",
		"expo-constants": "~57.0.22",
		"expo-device": "~57.0.2",
		"expo-haptics": "~57.0.3",
		"expo-secure-store": "~57.0.4",
		"expo-splash-screen": "~57.0.10",
		"expo-system-ui": "~57.0.4",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-webview": "13.16.1",
		"volt-mobile-widgets": "file:../mobile-widgets"
	},
	"devDependencies": {
		"@expo/repack-app": "^0.10.4",
		"@types/react": "~19.2.0",
		"typescript": "~5.9.3"
	},
	"expo": {
		"autolinking": {
			"exclude": [
				"@expo/dom-webview",
				"expo-file-system",
				"expo-font",
				"expo-keep-awake"
			]
		}
	}
}
