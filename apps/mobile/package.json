{
	"name": "volt-mobile",
	"version": "0.1.0",
	"private": true,
	"description": "Volt for iPhone, iPad and Android: pair with Volt on your computer and follow, steer and approve its agents from anywhere.",
	"license": "MIT",
	"author": "Volt ADK",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"prebuild": "expo prebuild",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"postinstall": "npm --prefix ../mobile-widgets install --omit=peer --no-package-lock --no-audit --no-fund --loglevel=error"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "2.2.0",
		"@volt/client-core": "file:../client-core",
		"expo": "~57.0.27",
		"expo-blur": "~57.0.3",
		"expo-build-properties": "~57.0.22",
		"expo-camera": "~57.0.6",
		"expo-clipboard": "~57.0.2",
		"expo-constants": "~57.0.21",
		"expo-device": "~57.0.2",
		"expo-document-picker": "~57.0.3",
		"expo-haptics": "~57.0.3",
		"expo-image-manipulator": "~57.0.21",
		"expo-image-picker": "~57.0.20",
		"expo-linking": "~57.0.12",
		"expo-network": "~57.0.2",
		"expo-router": "~57.0.25",
		"expo-secure-store": "~57.0.4",
		"expo-speech-recognition": "^57.1.1",
		"expo-splash-screen": "~57.0.9",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.4",
		"react": "19.2.3",
		"react-dom": "^19.2.3",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.10.1",
		"volt-mobile-widgets": "file:../mobile-widgets"
	},
	"devDependencies": {
		"@types/react": "~19.2.0",
		"typescript": "~5.9.3"
	}
}
