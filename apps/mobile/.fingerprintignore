# ios/ and android/ are generated by prebuild from app.json, the config plugins and the native
# modules, which the fingerprint already hashes; walking them (about 2 GB) only slows it down.
ios/**/*
android/**/*
dist/**/*
# The widgets plugin's tooling is installed by postinstall without a lockfile, so which copies
# its config plugin loads differs from one checkout to the next.
../mobile-widgets/node_modules/**/*
# An Android build rewrites some libraries' manifests in node_modules (it strips the package
# attribute), which would change the fingerprint of every checkout after its first build. A
# library's version, and with it its manifest, is still covered by its package.json.
node_modules/**/android/src/main/AndroidManifest.xml
